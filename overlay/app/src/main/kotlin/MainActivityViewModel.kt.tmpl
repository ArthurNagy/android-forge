package ${BASE_PACKAGE}

import androidx.lifecycle.ViewModel
import ${BASE_PACKAGE}.core.domain.ObserveThemeModeUseCase
import ${BASE_PACKAGE}.core.model.ThemeMode
import dagger.hilt.android.lifecycle.HiltViewModel
import org.orbitmvi.orbit.OrbitContainerHost
import org.orbitmvi.orbit.viewmodel.orbitContainer
import javax.inject.Inject

/** App-level state the activity needs before any screen: the theme to render in. */
@HiltViewModel
internal class MainActivityViewModel
    @Inject
    constructor(
        private val observeThemeMode: ObserveThemeModeUseCase,
    ) : ViewModel(),
        OrbitContainerHost<MainActivityState, MainActivityState, Nothing> {
        override val container =
            orbitContainer<MainActivityState, Nothing>(MainActivityState.Initial) {
                observeTheme()
            }

        private fun observeTheme() = intent {
            observeThemeMode().collect { mode -> reduce { state.copy(themeMode = mode) } }
        }
    }

internal data class MainActivityState(
    val themeMode: ThemeMode,
) {
    companion object {
        val Initial = MainActivityState(themeMode = ThemeMode.SYSTEM)
    }
}
