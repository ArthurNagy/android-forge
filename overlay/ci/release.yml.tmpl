name: Release
on:
  push:
    tags: ['v*']

jobs:
  android:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: |
            17
            21
      # setup-gradle v6: its caching is the proprietary `gradle-actions-caching` component — using it
      # accepts Gradle's Terms of Use (https://gradle.com/legal/terms-of-use/). Pin `@v5` (MIT) instead
      # if your project can't accept them. https://blog.gradle.org/github-actions-for-gradle-v6
      - uses: gradle/actions/setup-gradle@v6
      - name: Decode keystore
        env:
          ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
        run: echo "$ANDROID_KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/release.keystore"
      # Signs via AGP's injected signing properties (the same ones Android Studio's "Generate Signed
      # Bundle" uses) — no signingConfig in the app modules and no keystore path in the repo. Every
      # app module (:app and the form-factor apps :wear / :tv / :automotive) shares the upload key.
      - name: Build signed release AABs + APKs (every app module)
        env:
          KEYSTORE_PATH: ${{ runner.temp }}/release.keystore
          KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
        run: >-
          ./gradlew bundleRelease assembleRelease
          -Pandroid.injected.signing.store.file="$KEYSTORE_PATH"
          -Pandroid.injected.signing.store.password="$KEYSTORE_PASSWORD"
          -Pandroid.injected.signing.key.alias="$KEY_ALIAS"
          -Pandroid.injected.signing.key.password="$KEY_PASSWORD"
      - uses: actions/upload-artifact@v7
        with:
          name: android
          path: |
            */build/outputs/bundle/release/*.aab
            */build/outputs/apk/release/*.apk
            */build/outputs/mapping/release/mapping.txt
          if-no-files-found: error

  changelog-and-release:
    needs: [android]
    runs-on: ubuntu-latest
    # Creating a Release needs write access; new repos default GITHUB_TOKEN to read-only.
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: actions/download-artifact@v8
        with:
          path: artifacts
      - name: Generate changelog
        id: cliff
        uses: orhun/git-cliff-action@v4
        with:
          config: cliff.toml
          args: --latest --strip header
      - name: Create GitHub Release
        uses: softprops/action-gh-release@v3
        with:
          body: ${{ steps.cliff.outputs.content }}
          files: |
            artifacts/android/**/*.aab
            artifacts/android/**/*.apk
          generate_release_notes: false
