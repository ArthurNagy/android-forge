/**
 * The home-screen widget: the app name in a title bar and a body that opens the app. A starting
 * point — pick the closest canonical layout (glance-canonical-layouts skill) for real content.
 */
internal class HomeWidget : GlanceAppWidget() {
    // Exact: the host asks for the widget at its actual size, and nothing else is kept in memory.
    override val sizeMode: SizeMode = SizeMode.Exact

    override suspend fun provideGlance(
        context: Context,
        id: GlanceId,
    ) {
        // The app's launcher activity, resolved at runtime: :widget never depends on :app.
        val openApp = context.packageManager.getLaunchIntentForPackage(context.packageName)?.let { actionStartActivity(it) }
        provideContent {
            GlanceTheme { HomeWidgetContent(openApp = openApp) }
        }
    }
}

/** Public only because the manifest names it: Android instantiates it and Glance renders [HomeWidget]. */
class HomeWidgetReceiver : GlanceAppWidgetReceiver() {
    override val glanceAppWidget: GlanceAppWidget = HomeWidget()
}

/** Stateless widget UI — unit-tested with runGlanceAppWidgetUnitTest and previewed below. */
@Composable
internal fun HomeWidgetContent(
    openApp: Action?,
    modifier: GlanceModifier = GlanceModifier,
) {
    val context = LocalContext.current
    val openLabel = context.getString(R.string.widget_home_open)
    Scaffold(
        modifier =
            modifier
                .semantics { contentDescription = openLabel }
                .then(if (openApp != null) GlanceModifier.clickable(openApp) else GlanceModifier),
        titleBar = {
            TitleBar(
                startIcon = ImageProvider(R.drawable.widget_ic_home),
                title = context.getString(R.string.widget_home_title),
            )
        },
    ) {
        Text(text = openLabel, style = TextStyle(color = GlanceTheme.colors.onSurface))
    }
}

// The size of a 2x2 widget on a smaller phone (widget sizing guidance).
@OptIn(ExperimentalGlancePreviewApi::class)
@Preview(widthDp = 172, heightDp = 234)
@Composable
private fun HomeWidgetPreview() {
    GlanceTheme { HomeWidgetContent(openApp = null) }
}
