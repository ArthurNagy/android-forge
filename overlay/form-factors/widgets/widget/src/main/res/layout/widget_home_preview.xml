<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (RemoteViews-safe views only). Mirrors HomeWidgetContent's title + body.
     The launcher inflates it as RemoteViews — no activity theme paints behind it, so Overdraw doesn't apply. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:padding="@dimen/widget_home_preview_padding"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_home_title"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_home_open"
        android:textAppearance="?android:attr/textAppearanceSmall" />
</LinearLayout>
