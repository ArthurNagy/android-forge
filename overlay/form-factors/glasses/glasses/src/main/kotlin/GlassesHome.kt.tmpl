package ${BASE_PACKAGE}.glasses

import androidx.compose.foundation.background
import androidx.compose.foundation.layout.Box
import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.runtime.Composable
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.res.stringResource
import androidx.xr.glimmer.ActionCard
import androidx.xr.glimmer.Button
import androidx.xr.glimmer.Text

/**
 * The glasses' first screen: one card, bottom-aligned, on pure black — an additive display renders
 * black as transparent, so anything else would block the wearer's view. One thing at a time; Glimmer
 * components only (Glimmer Text picks a readable color from the surface it sits on).
 */
@Composable
internal fun GlassesHome(
    onClose: () -> Unit,
    modifier: Modifier = Modifier,
) {
    Box(
        modifier = modifier.fillMaxSize().background(Color.Black),
        contentAlignment = Alignment.BottomCenter,
    ) {
        ActionCard(
            title = { Text(stringResource(R.string.glasses_app_name)) },
            action = { Button(onClick = onClose) { Text(stringResource(R.string.glasses_close)) } },
        ) {
            Text(stringResource(R.string.glasses_home_body))
        }
    }
}
