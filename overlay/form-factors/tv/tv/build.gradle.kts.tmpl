// The Android TV / Google TV app (ADR 0009): its own APK with the phone app's applicationId, on Compose for TV.
// It reuses :core:model / :core:domain / :core:data (the DI graph) — never the phone UI modules
// (:core:designsystem, :core:ui, phone features): TV has its own components, focus model and 10-foot layouts.
plugins {
    id("android-forge.android.application")
    id("android-forge.hilt")
}

android {
    namespace = "${BASE_PACKAGE}.tv"
    resourcePrefix = "tv_"
    defaultConfig {
        applicationId = "${BASE_PACKAGE}"
        // minSdk: the project's (tv-material needs 23). TV ready (TV-PS) wants 31 or lower: a project on 33
        // misses many Android TV devices.
        // Play needs a version code unique across every APK of the listing: keep the TV's apart from :app's.
        versionCode = 200_000_001
        versionName = "0.1.0"
    }
}

dependencies {
    implementation(project(":core:model"))
    implementation(project(":core:domain"))
    implementation(project(":core:data")) // only the app modules depend on :core:data — they assemble the DI graph

    implementation(libs.androidx.tv.material)
    implementation(libs.androidx.hilt.lifecycle.viewmodel.compose)
    implementation(libs.orbit.viewmodel)
    implementation(libs.orbit.compose)
    implementation(libs.timber)

    testImplementation(libs.orbit.test)
}
