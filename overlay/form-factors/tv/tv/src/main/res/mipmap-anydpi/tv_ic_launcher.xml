<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder launcher icon. TV supports adaptive icons but not round ones (no android:roundIcon); TV doesn't
     theme icons either, the monochrome layer is there for lint (MonochromeLauncherIcon). Replace with the app's
     own artwork (the TV icon guidelines' Figma template). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/tv_ic_launcher_background" />
    <foreground android:drawable="@drawable/tv_ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/tv_ic_launcher_foreground" />
</adaptive-icon>
