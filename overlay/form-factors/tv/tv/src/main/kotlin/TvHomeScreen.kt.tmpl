/**
 * Stateful entry: wires [TvHomeViewModel] into the stateless [TvHomeContent], in [TvTheme] with the stored
 * mode. (With a second screen, hoist the theme into an activity-level ViewModel, as :app's
 * MainActivityViewModel does, and add a Nav 3 NavDisplay.)
 */
@Composable
internal fun TvHomeScreen(
    modifier: Modifier = Modifier,
    viewModel: TvHomeViewModel = hiltViewModel(),
) {
    val state by viewModel.collectAsState()
    TvTheme(themeMode = state.themeMode) {
        TvHomeContent(state = state, onThemeModeSelect = viewModel::onThemeModeSelected, modifier = modifier)
    }
}

/**
 * A 10-foot layout inside the overscan-safe margins: the app name and one row of D-pad-focusable cards.
 * TV components don't take focus by themselves — the first card requests it when the screen opens.
 */
@Composable
internal fun TvHomeContent(
    state: TvHomeState,
    onThemeModeSelect: (ThemeMode) -> Unit,
    modifier: Modifier = Modifier,
) {
    val firstCard = remember { FocusRequester() }
    LaunchedEffect(Unit) { firstCard.requestFocus() }

    Surface(modifier = modifier.fillMaxSize()) {
        Column(
            modifier = Modifier.padding(horizontal = TvSpacing.overscanHorizontal, vertical = TvSpacing.overscanVertical),
            verticalArrangement = Arrangement.spacedBy(TvSpacing.gap),
        ) {
            Text(text = stringResource(R.string.tv_app_name), style = MaterialTheme.typography.displaySmall)
            Text(text = stringResource(R.string.tv_home_theme), style = MaterialTheme.typography.titleLarge)
            Row(horizontalArrangement = Arrangement.spacedBy(TvSpacing.gap)) {
                ThemeMode.entries.forEachIndexed { index, mode ->
                    val selected = mode == state.themeMode
                    ClassicCard(
                        onClick = { onThemeModeSelect(mode) },
                        image = { ThemeSwatch(mode, Modifier.fillMaxWidth().aspectRatio(SWATCH_ASPECT_RATIO)) },
                        title = { Text(text = stringResource(mode.labelRes()), modifier = Modifier.padding(TvSpacing.cardText)) },
                        subtitle = {
                            if (selected) {
                                Text(
                                    text = stringResource(R.string.tv_home_theme_current),
                                    style = MaterialTheme.typography.labelMedium,
                                    modifier = Modifier.padding(horizontal = TvSpacing.cardText),
                                )
                            }
                        },
                        // The standard TV focus animation: the focused card grows.
                        scale = CardDefaults.scale(focusedScale = FOCUSED_SCALE),
                        modifier = Modifier
                            .width(TvSpacing.cardWidth)
                            .then(if (index == 0) Modifier.focusRequester(firstCard) else Modifier)
                            .semantics { this.selected = selected }
                            .testTag("tv:theme:${mode.name}"),
                    )
                }
            }
        }
    }
}

/** A preview of the mode's surface color; SYSTEM shows both halves. Decorative — the card's title names it. */
@Composable
private fun ThemeSwatch(
    mode: ThemeMode,
    modifier: Modifier = Modifier,
) {
    val brush = remember(mode) {
        val light = lightColorScheme().surfaceVariant
        val dark = darkColorScheme().surfaceVariant
        when (mode) {
            ThemeMode.LIGHT -> SolidColor(light)
            ThemeMode.DARK -> SolidColor(dark)
            ThemeMode.SYSTEM -> Brush.horizontalGradient(0.5f to light, 0.5f to dark)
        }
    }
    Box(modifier = modifier.background(brush))
}

@StringRes
private fun ThemeMode.labelRes(): Int = when (this) {
    ThemeMode.LIGHT -> R.string.tv_theme_light
    ThemeMode.DARK -> R.string.tv_theme_dark
    ThemeMode.SYSTEM -> R.string.tv_theme_system
}

private const val FOCUSED_SCALE = 1.1f
private const val SWATCH_ASPECT_RATIO = 16f / 9f
