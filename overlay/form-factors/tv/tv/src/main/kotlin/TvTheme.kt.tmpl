package ${BASE_PACKAGE}.tv

import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.runtime.Composable
import androidx.compose.ui.unit.dp
import androidx.tv.material3.MaterialTheme
import androidx.tv.material3.darkColorScheme
import androidx.tv.material3.lightColorScheme
import ${BASE_PACKAGE}.core.model.ThemeMode

/**
 * Compose for TV's Material 3 theme (`androidx.tv.material3` — never the mobile `androidx.compose.material3`
 * in this module: two MaterialThemes drift apart) in the stored [ThemeMode]; SYSTEM follows the TV's UI
 * mode, which is dark on almost every TV.
 */
@Composable
internal fun TvTheme(
    themeMode: ThemeMode,
    content: @Composable () -> Unit,
) {
    val dark = when (themeMode) {
        ThemeMode.LIGHT -> false
        ThemeMode.DARK -> true
        ThemeMode.SYSTEM -> isSystemInDarkTheme()
    }
    MaterialTheme(colorScheme = if (dark) darkColorScheme() else lightColorScheme(), content = content)
}

/** 10-foot layout tokens. */
internal object TvSpacing {
    /** Overscan-safe margins (5% of the 960x540dp TV screen): no text or control may sit closer to the edge. */
    val overscanHorizontal = 48.dp
    val overscanVertical = 27.dp

    /** Between cards and sections; leaves room for a focused card's 1.1x scale. */
    val gap = 24.dp

    val cardWidth = 196.dp
    val cardText = 12.dp
}
