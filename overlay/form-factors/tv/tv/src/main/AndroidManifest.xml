<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A TV-only APK: required="true" makes Play offer it on Android TV / Google TV devices only. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <!-- TVs have no touchscreen; without this Play doesn't list the app on TV. Any other hardware the app can
         use (camera, microphone, …) must be required="false" too. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/tv_ic_launcher"
        android:label="@string/tv_app_name"
        android:supportsRtl="true"
        android:theme="@style/Tv.Theme">

        <!-- LEANBACK_LAUNCHER: what puts the app on the TV home screen (and Play's TV catalog). -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
