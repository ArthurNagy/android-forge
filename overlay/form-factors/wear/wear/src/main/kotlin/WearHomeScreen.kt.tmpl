import androidx.wear.compose.material3.lazy.rememberTransformationSpec
import androidx.wear.compose.material3.lazy.transformedHeight
import ${BASE_PACKAGE}.core.model.ThemeMode
import org.orbitmvi.orbit.compose.collectAsState

/** Stateful entry: wires [WearHomeViewModel] into the stateless [WearHomeContent]. */
@Composable
internal fun WearHomeScreen(
    modifier: Modifier = Modifier,
    viewModel: WearHomeViewModel = hiltViewModel(),
) {
    val state by viewModel.collectAsState()
    WearHomeContent(state = state, onThemeModeSelect = viewModel::onThemeModeSelected, modifier = modifier)
}

/**
 * A scrolling list (TransformingLazyColumn — items morph at the round screen's edges) inside the screen's
 * ScreenScaffold, which hosts the scroll indicator and scrolls the TimeText away.
 */
@Composable
internal fun WearHomeContent(
    state: WearHomeState,
    onThemeModeSelect: (ThemeMode) -> Unit,
    modifier: Modifier = Modifier,
) {
    val listState = rememberTransformingLazyColumnState()
    val transformationSpec = rememberTransformationSpec()
    ScreenScaffold(
        scrollState = listState,
        modifier = modifier,
        // No indicator in scroll-capture (long) screenshots.
        scrollIndicator = {
            if (!LocalScrollCaptureInProgress.current) {
                ScrollIndicator(listState, modifier = Modifier.align(Alignment.CenterEnd))
            }
        },
    ) { contentPadding ->
        TransformingLazyColumn(
            state = listState,
            contentPadding = contentPadding,
            modifier = Modifier.fillMaxSize(),
        ) {
            item {
                ListHeader(
                    modifier = Modifier
                        .fillMaxWidth()
                        .transformedHeight(this, transformationSpec)
                        .minimumVerticalContentPadding(ListHeaderDefaults.minimumTopListContentPadding),
                    transformation = SurfaceTransformation(transformationSpec),
                ) {
                    Text(text = stringResource(R.string.wear_app_name))
                }
            }
            item {
                ListSubHeader(
                    modifier = Modifier
                        .fillMaxWidth()
                        .transformedHeight(this, transformationSpec)
                        .minimumVerticalContentPadding(ListHeaderDefaults.minimumTopListContentPadding),
                    transformation = SurfaceTransformation(transformationSpec),
                    label = { Text(text = stringResource(R.string.wear_home_theme)) },
                )
            }
            items(ThemeMode.entries) { mode ->
                RadioButton(
                    selected = mode == state.themeMode,
                    onSelect = { onThemeModeSelect(mode) },
                    modifier = Modifier
                        .fillMaxWidth()
                        .transformedHeight(this, transformationSpec)
                        .minimumVerticalContentPadding(ButtonDefaults.minimumVerticalListContentPadding)
                        .testTag("wear:theme:${mode.name}"),
                    transformation = SurfaceTransformation(transformationSpec),
                    label = { Text(text = stringResource(mode.labelRes()), maxLines = 2, overflow = TextOverflow.Ellipsis) },
                )
            }
        }
    }
}

@StringRes
private fun ThemeMode.labelRes(): Int = when (this) {
    ThemeMode.LIGHT -> R.string.wear_theme_light
    ThemeMode.DARK -> R.string.wear_theme_dark
    ThemeMode.SYSTEM -> R.string.wear_theme_system
}
