package ${BASE_PACKAGE}.wear

import androidx.compose.runtime.Composable
import androidx.compose.ui.test.assertIsNotSelected
import androidx.compose.ui.test.hasTestTag
import androidx.compose.ui.test.isSelected
import androidx.compose.ui.test.junit4.v2.createComposeRule
import androidx.compose.ui.test.onNodeWithTag
import androidx.compose.ui.test.onNodeWithText
import androidx.compose.ui.test.onRoot
import androidx.compose.ui.test.performClick
import androidx.test.ext.junit.runners.AndroidJUnit4
import androidx.wear.compose.material3.TimeSource
import androidx.wear.compose.material3.TimeText
import ${BASE_PACKAGE}.core.domain.ObserveThemeModeUseCase
import ${BASE_PACKAGE}.core.domain.SetThemeModeUseCase
import ${BASE_PACKAGE}.core.model.ThemeMode
import ${BASE_PACKAGE}.core.testing.FakeUserPreferencesRepository
import com.github.takahirom.roborazzi.RobolectricDeviceQualifiers
import com.github.takahirom.roborazzi.captureRoboImage
import org.junit.Rule
import org.junit.Test
import org.junit.runner.RunWith
import org.robolectric.annotation.Config
import org.robolectric.annotation.GraphicsMode
import kotlin.test.assertEquals

@RunWith(AndroidJUnit4::class)
@GraphicsMode(GraphicsMode.Mode.NATIVE)
@Config(qualifiers = RobolectricDeviceQualifiers.WearOSLargeRound)
class WearHomeScreenTest {
    @get:Rule
    val composeRule = createComposeRule()

    /** A fixed clock, so the TimeText in the goldens never changes. */
    private object TenTen : TimeSource {
        @Composable
        override fun currentTime(): String = "10:10"
    }

    @Test
    fun tappingAModeSelectsIt() {
        var selected: ThemeMode? = null
        composeRule.setContent {
            WearApp { WearHomeContent(WearHomeState(themeMode = ThemeMode.SYSTEM), onThemeModeSelect = { selected = it }) }
        }

        composeRule.onNodeWithText("${APP_NAME}").assertExists()
        composeRule.onNodeWithTag("wear:theme:DARK").performClick()

        assertEquals(ThemeMode.DARK, selected)
    }

    @Test
    fun theScreenFollowsTheStoredMode() {
        val repository = FakeUserPreferencesRepository(ThemeMode.DARK)
        val viewModel = WearHomeViewModel(ObserveThemeModeUseCase(repository), SetThemeModeUseCase(repository))
        composeRule.setContent { WearApp { WearHomeScreen(viewModel = viewModel) } }

        waitUntilSelected("wear:theme:DARK")
        composeRule.onNodeWithTag("wear:theme:LIGHT").performClick()

        waitUntilSelected("wear:theme:LIGHT")
        composeRule.onNodeWithTag("wear:theme:DARK").assertIsNotSelected()
    }

    /** Orbit reduces off the main thread, which the compose rule doesn't wait for: wait for the state instead. */
    private fun waitUntilSelected(tag: String) {
        composeRule.waitUntil { composeRule.onAllNodes(hasTestTag(tag) and isSelected()).fetchSemanticsNodes().isNotEmpty() }
    }

    @Test
    fun largeRound() {
        composeRule.setContent { Golden() }
        composeRule.onRoot().captureRoboImage()
    }

    @Test
    @Config(qualifiers = RobolectricDeviceQualifiers.WearOSSmallRound)
    fun smallRound() {
        composeRule.setContent { Golden() }
        composeRule.onRoot().captureRoboImage()
    }

    /** Square watches too: nothing cut off by the screen edges or overlapping (WO-V16). */
    @Test
    @Config(qualifiers = RobolectricDeviceQualifiers.WearOSSquare)
    fun square() {
        composeRule.setContent { Golden() }
        composeRule.onRoot().captureRoboImage()
    }

    @Composable
    private fun Golden() {
        WearApp(timeText = { TimeText(timeSource = TenTen) }) {
            WearHomeContent(WearHomeState(themeMode = ThemeMode.SYSTEM), onThemeModeSelect = {})
        }
    }
}
