# Google Cast sender (Media3). Added by /android-forge-add-form-factor cast; used once the first media slice
# creates :core:media (docs/form-factors/cast.md, the media3-cast-integration skill). Keep every media3 artifact on
# the one `media3` version.

[versions]
media3 = "1.11.1"

[libraries]
androidx-media3-exoplayer = { module = "androidx.media3:media3-exoplayer", version.ref = "media3" }
androidx-media3-session = { module = "androidx.media3:media3-session", version.ref = "media3" }
androidx-media3-ui-compose = { module = "androidx.media3:media3-ui-compose", version.ref = "media3" }
androidx-media3-cast = { module = "androidx.media3:media3-cast", version.ref = "media3" }
