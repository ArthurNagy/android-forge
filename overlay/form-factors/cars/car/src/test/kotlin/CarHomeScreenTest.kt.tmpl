package ${BASE_PACKAGE}.car

import android.content.Intent
import androidx.car.app.ScreenManager
import androidx.car.app.model.Action
import androidx.car.app.model.ListTemplate
import androidx.car.app.model.Row
import androidx.car.app.testing.ScreenController
import androidx.car.app.testing.SessionController
import androidx.car.app.testing.TestCarContext
import androidx.lifecycle.Lifecycle
import androidx.test.core.app.ApplicationProvider
import androidx.test.ext.junit.runners.AndroidJUnit4
import org.junit.Test
import org.junit.runner.RunWith
import kotlin.test.assertEquals
import kotlin.test.assertIs

@RunWith(AndroidJUnit4::class)
class CarHomeScreenTest {
    private val carContext = TestCarContext.createCarContext(ApplicationProvider.getApplicationContext())

    @Test
    fun theHomeScreenShowsTheAppNameAndAWelcomeRow() {
        val controller = ScreenController(CarHomeScreen(carContext)).moveToState(Lifecycle.State.RESUMED)
        controller.screen.invalidate() // the fake host asks for the template, as a real host does

        val template = assertIs<ListTemplate>(controller.templatesReturned.last())
        val header = requireNotNull(template.header)
        assertEquals(carContext.getString(R.string.car_app_name), header.title.toString())
        assertEquals(Action.APP_ICON, header.startHeaderAction)
        val row = assertIs<Row>(requireNotNull(template.singleList).items.single())
        assertEquals(carContext.getString(R.string.car_home_row_title), row.title.toString())
    }

    @Test
    fun aNewSessionStartsOnTheHomeScreen() {
        SessionController(MainCarSession(), carContext, Intent()).moveToState(Lifecycle.State.CREATED)

        assertIs<CarHomeScreen>(carContext.getCarService(ScreenManager::class.java).top)
    }
}
