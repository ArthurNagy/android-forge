package ${BASE_PACKAGE}.car

import androidx.car.app.CarContext
import androidx.car.app.Screen
import androidx.car.app.model.Action
import androidx.car.app.model.Header
import androidx.car.app.model.ItemList
import androidx.car.app.model.ListTemplate
import androidx.car.app.model.Row
import androidx.car.app.model.Template

/**
 * The car app's first screen: a ListTemplate with the app name and one row — valid for every
 * templated category (POI, IoT, weather, navigation, messaging). Replace it with the category's
 * own templates (POI → PlaceListMapTemplate, IoT → GridTemplate, navigation → NavigationTemplate, …).
 *
 * The host draws the template; call [invalidate] after the data behind it changes and
 * [onGetTemplate] runs again (refreshes of the same template type don't count toward the quota).
 */
internal class CarHomeScreen(
    carContext: CarContext,
) : Screen(carContext) {
    override fun onGetTemplate(): Template {
        val welcome =
            Row
                .Builder()
                .setTitle(carContext.getString(R.string.car_home_row_title))
                .build()
        return ListTemplate
            .Builder()
            .setHeader(
                Header
                    .Builder()
                    .setTitle(carContext.getString(R.string.car_app_name))
                    .setStartHeaderAction(Action.APP_ICON)
                    .build(),
            ).setSingleList(ItemList.Builder().addItem(welcome).build())
            .build()
    }
}
